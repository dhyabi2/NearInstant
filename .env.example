# NearInstant — TEMPLATE for local test wallet keys.
#
# Copy to .env and fill in. .env is git-ignored (.gitignore: .env, .env.*) and
# is never deployed — the Vercel step only uploads deploy/vercel. Keep .env at
# mode 0600. These are TEST wallets: never fund them with anything you'd miss.

# --- WALLET A -------------------------------------------------------------
# One seed derives BOTH chains, the way this app derives them.
WALLET_A_SEED=
WALLET_A_NANO_ADDRESS=
WALLET_A_XMR_ADDRESS=

# --- WALLET B -------------------------------------------------------------
# NOTE: a STANDARD Monero seed (spend = sc_reduce32(seed)) is NOT interchangeable
# with this app's seed (Blake2b, domain-separated). To use an external Monero
# wallet here, restore it by SPEND KEY, not by seed.
WALLET_B_XMR_SEED=
WALLET_B_XMR_ADDRESS=
WALLET_B_XMR_SPEND_KEY=
WALLET_B_XMR_VIEW_KEY=
WALLET_B_XMR_RESTORE_HEIGHT=
WALLET_B_NANO_ADDRESS=
WALLET_B_NANO_PRIVATE_KEY=

# --- JOINT RECOVERY -------------------------------------------------------
# 2-of-2 addresses from a live self-swap test.
# Joint Monero spend secret = xmr_joint_secret(CTX, A_XMR, B_XMR).
SWAPTEST_CTX=
SWAPTEST_A_XMR=
SWAPTEST_B_XMR=
SWAPTEST_T=
SWAPTEST_VIEW_A=
SWAPTEST_VIEW_B=
SWAPTEST_JOINT_MONERO=
SWAPTEST_JOINT_NANO=
